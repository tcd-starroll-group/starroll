// This is a sample environment configuration file.
// 1. Create a new file named .env in the same location as this file.
// 2. Copy the contents of this file into the .env file.
// 3. Modify the values to match your environment.
// 4. See backend/config/settings.py for all supported fields.

APP_ENV=dev

// --- MySQL (matches docker-compose.yml) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root_password
MYSQL_DB_NAME=social_system

// --- JWT ---
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

// --- MinIO (matches docker-compose.yml) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123

// --- Astronomy.net (local Docker) ---
ASTRONOMY_NET_ENDPOINT=http://127.0.0.1:8001

// --- Redis (matches docker-compose.yml) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
